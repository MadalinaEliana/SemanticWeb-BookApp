<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/radu/ontologies/2026/4/untitled-ontology-9/"
     xml:base="http://www.semanticweb.org/radu/ontologies/2026/4/untitled-ontology-9/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontology="http://example.org/book-recommendation/ontology#">
    <owl:Ontology rdf:about="http://example.org/book-recommendation/ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/book-recommendation/ontology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation/ontology#hasGenre">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/book-recommendation/ontology#hasPreferredTheme -->

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation/ontology#hasPreferredTheme">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#User"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/book-recommendation/ontology#hasReadingLevelMatch -->

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation/ontology#hasReadingLevelMatch">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation/ontology#User"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/book-recommendation/ontology#isRecommendedFor -->

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation/ontology#isRecommendedFor">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation/ontology#User"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/book-recommendation/ontology#hasAuthor -->

    <owl:DatatypeProperty rdf:about="http://example.org/book-recommendation/ontology#hasAuthor">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/book-recommendation/ontology#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://example.org/book-recommendation/ontology#hasDescription">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/book-recommendation/ontology#hasName -->

    <owl:DatatypeProperty rdf:about="http://example.org/book-recommendation/ontology#hasName">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/book-recommendation/ontology#hasReadingLevel -->

    <owl:DatatypeProperty rdf:about="http://example.org/book-recommendation/ontology#hasReadingLevel">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/book-recommendation/ontology#hasTitle -->

    <owl:DatatypeProperty rdf:about="http://example.org/book-recommendation/ontology#hasTitle">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/book-recommendation/ontology#Book -->

    <owl:Class rdf:about="http://example.org/book-recommendation/ontology#Book">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/book-recommendation/ontology#hasGenre"/>
                <owl:someValuesFrom rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/book-recommendation/ontology#Themes -->

    <owl:Class rdf:about="http://example.org/book-recommendation/ontology#Themes"/>
    


    <!-- http://example.org/book-recommendation/ontology#User -->

    <owl:Class rdf:about="http://example.org/book-recommendation/ontology#User">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/book-recommendation/ontology#hasPreferredTheme"/>
                <owl:someValuesFrom rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/book-recommendation/ontology#Alice -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Alice">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#User"/>
        <ontology:hasPreferredTheme rdf:resource="http://example.org/book-recommendation/ontology#ScienceFiction"/>
        <ontology:hasName>Alice</ontology:hasName>
        <ontology:hasReadingLevel>Intermediate</ontology:hasReadingLevel>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#Bob -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Bob">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#User"/>
        <ontology:hasPreferredTheme rdf:resource="http://example.org/book-recommendation/ontology#Mystery"/>
        <ontology:hasName>Bob</ontology:hasName>
        <ontology:hasReadingLevel>Beginner</ontology:hasReadingLevel>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#Dune -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Dune">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <ontology:hasGenre rdf:resource="http://example.org/book-recommendation/ontology#Fantasy"/>
        <ontology:hasGenre rdf:resource="http://example.org/book-recommendation/ontology#ScienceFiction"/>
        <ontology:hasAuthor>Frank Herbert</ontology:hasAuthor>
        <ontology:hasName>Dune</ontology:hasName>
        <ontology:hasReadingLevel>Advanced</ontology:hasReadingLevel>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#Fantasy -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Fantasy">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
        <ontology:hasName>Fantasy</ontology:hasName>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#Hunger_Games -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Hunger_Games">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <ontology:hasGenre rdf:resource="http://example.org/book-recommendation/ontology#Fantasy"/>
        <ontology:hasGenre rdf:resource="http://example.org/book-recommendation/ontology#ScienceFiction"/>
        <ontology:hasAuthor>Suzanne Collins</ontology:hasAuthor>
        <ontology:hasReadingLevel>Beginner</ontology:hasReadingLevel>
        <ontology:hasTitle>Hunger Games</ontology:hasTitle>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#Murder -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Murder">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
        <ontology:hasName>Murder</ontology:hasName>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#Mystery -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#Mystery">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
        <ontology:hasName>Mystery</ontology:hasName>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#ScienceFiction -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#ScienceFiction">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
        <ontology:hasName>Science Fiction</ontology:hasName>
    </owl:NamedIndividual>
    


    <!-- http://example.org/book-recommendation/ontology#The_Silent_Patient -->

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation/ontology#The_Silent_Patient">
        <rdf:type rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
        <ontology:hasGenre rdf:resource="http://example.org/book-recommendation/ontology#Murder"/>
        <ontology:hasGenre rdf:resource="http://example.org/book-recommendation/ontology#Mystery"/>
        <ontology:hasAuthor>Alex Michaelides</ontology:hasAuthor>
        <ontology:hasReadingLevel>Intermediate</ontology:hasReadingLevel>
        <ontology:hasTitle>The Silent Patient</ontology:hasTitle>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/book-recommendation/ontology#Book"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/book-recommendation/ontology#hasGenre"/>
                <owl:someValuesFrom rdf:resource="http://example.org/book-recommendation/ontology#Themes"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/book-recommendation/ontology#hasReadingLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:intersectionOf>
        <rdfs:subClassOf rdf:resource="http://example.org/book-recommendation/ontology#Book"/>
    </owl:Class>
